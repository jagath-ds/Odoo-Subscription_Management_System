# ==============================================================================
# BrightLoop Subscription ERP - backend environment template
# ==============================================================================
# 1. Copy this file to `.env` in the repository root:
#        Windows:    copy .env.example .env
#        Mac/Linux:  cp .env.example .env
# 2. Replace every placeholder below with your local values.
# 3. NEVER commit `.env` - it is git-ignored.
# The frontend has its own template at frontend/.env.example.
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000

# --- Database (PostgreSQL 15+) ------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Create the database first:  CREATE DATABASE brightloop_erp;
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/brightloop_erp

# --- Security / JWT -------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-character-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend link-up -------------------------------------------------------------
# Public URL of the React app (used to build password-reset links).
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Password-reset email (optional) ---------------------------------------------------
# Leave SMTP_HOST empty to print reset links to the API console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Demo seed accounts (python -m backend.seed) -------------------------------------
# Passwords must be 9+ chars with upper, lower and a special character.
DEMO_ADMIN_EMAIL=admin@brightloop.local
DEMO_STAFF_EMAIL=staff@brightloop.local
DEMO_CUSTOMER_EMAIL=customer@brightloop.local
DEMO_PASSWORD=Brightloop@123
