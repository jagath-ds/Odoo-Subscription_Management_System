# Brightloop Software - Subscription & Recurring Billing ERP
# Safe Environment Configuration Template for Teammates
# Copy this file to .env and replace placeholders with real local values

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://brightloop_user:change_me_password@localhost:5432/brightloop_db

# Security & Authentication
JWT_SECRET_KEY=change_me_to_a_secure_random_secret_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business Logic Engine Configuration
DEFAULT_TAX_RATE=18.00
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
