# ==============================================================================
# Brightloop Subscription Management System - Environment Variables Template
# ==============================================================================
# SECURITY NOTICE:
# DO NOT commit the actual `.env` file containing real secrets/passwords to git!
# This file (`.env.example`) serves as a safe template for teammates.
#
# QUICK START:
# 1. Copy this file to `.env`:
#      Windows:    copy .env.example .env
#      Mac/Linux:  cp .env.example .env
# 2. Update the values below to match your local setup or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Data Source:
#   true  = Deterministic in-memory mock store (works standalone without backend)
#   false = Live backend connection via FastAPI
VITE_USE_MOCK=true

# FastAPI Backend Base URL (only queried when VITE_USE_MOCK=false)
# Keep backend API URL and ports configurable here instead of hardcoding
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Python)
# ------------------------------------------------------------------------------
# Server host & port
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Database Connection URL (PostgreSQL default; or SQLite for quick local testing)
# PostgreSQL Example:
DATABASE_URL=postgresql://brightloop_user:brightloop_pass@localhost:5432/brightloop_db
# SQLite Example (uncomment for zero-config local testing):
# DATABASE_URL=sqlite:///./brightloop.db

# Security & JWT Tokens
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated URLs for frontend access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
