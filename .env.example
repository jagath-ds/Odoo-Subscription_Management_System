# Copy to .env and fill in your values. Never commit .env.

ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000

# URL-encode special characters in the password (@ -> %40, # -> %23)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/brightloop_erp

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-character-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: leave SMTP_HOST empty to print reset links to the API console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DEMO_ADMIN_EMAIL=admin@brightloop.local
DEMO_STAFF_EMAIL=staff@brightloop.local
DEMO_CUSTOMER_EMAIL=customer@brightloop.local
DEMO_PASSWORD=Brightloop@123
