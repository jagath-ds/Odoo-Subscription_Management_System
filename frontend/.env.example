# ==============================================================================
# BrightLoop frontend (Vite) environment template
# Copy to frontend/.env  (Windows: copy .env.example .env | Mac/Linux: cp .env.example .env)
# Vite only exposes variables prefixed with VITE_. Restart `npm run dev` after edits.
# ==============================================================================

# Base URL of the FastAPI backend (no trailing slash). Must be listed in the
# backend's CORS_ORIGINS for the browser to accept responses.
VITE_API_BASE_URL=http://127.0.0.1:8000

# false (default) = live FastAPI backend
# true            = offline in-memory demo store (no backend needed)
VITE_USE_MOCK=false
