# ==============================================================================
# Brightloop .gitignore
# ==============================================================================

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/

# Build outputs
dist/
dist-ssr/
frontend/dist/
*.tsbuildinfo

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
*.py[cod]
__pycache__/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Environment Variables & Secrets (Keep private info strictly local)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
frontend/.env
frontend/.env.local

# Allow example files to be committed as templates
!.env.example
!frontend/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Test coverage
coverage/
