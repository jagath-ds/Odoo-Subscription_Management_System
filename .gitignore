# ==============================================================================
# BrightLoop Subscription ERP - .gitignore
# ==============================================================================

# --- Secrets & local environment -------------------------------------------------
.env
.env.*
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example

# --- Python ------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.sqlite3

# --- Node / frontend -----------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# --- Tooling, editors & OS --------------------------------------------------------------
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.log
*.tmp
.DS_Store
Thumbs.db
Desktop.ini
